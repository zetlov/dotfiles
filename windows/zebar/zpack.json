{
  "name": "zetshell",
  "version": "1.0.0",
  "description": "A Windows bar adapted from the Arch Zetshell Quickshell bar.",
  "widgets": [
    {
      "name": "bar",
      "htmlPath": "./dist/index.html",
      "zOrder": "top_most",
      "shownInTaskbar": false,
      "focused": false,
      "resizable": false,
      "transparent": true,
      "includeFiles": [
        "dist/**/*"
      ],
      "privileges": {
        "shellCommands": [
          {
            "program": "C:\\Windows\\System32\\nvidia-smi.exe",
            "argsRegex": "^--query-gpu=utilization\\.gpu,temperature\\.gpu --format=csv,noheader,nounits --id=0 --loop-ms=2000$"
          }
        ]
      },
      "presets": [
        {
          "name": "primary-monitor",
          "anchor": "top_center",
          "offsetX": "0px",
          "offsetY": "0px",
          "width": "100%",
          "height": "42px",
          "monitorSelection": {
            "type": "primary"
          },
          "dockToEdge": {
            "enabled": true,
            "edge": "top",
            "windowMargin": "0px"
          }
        }
      ]
    }
  ]
}
