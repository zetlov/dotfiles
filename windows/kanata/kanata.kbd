(defcfg
  process-unmapped-keys yes
)

(defvar
  tap  170
  hold 220
)

(defvirtualkeys
  game-mode nop0
)

(defalias
  ;; Space is plain while a foreground game is active. Otherwise, tap=space
  ;; and hold=navigation layer.
  spcnav (switch
    ((input virtual game-mode)) spc break
    () (tap-hold-press $tap $hold spc (layer-while-held nav)) break)

  ;; Dedicated physical keys beside Space: tap=IME / hold=GlazeWM layer.
  imeoffmod (tap-hold-press 120 180 f13 (layer-while-held wm))
  imeonmod (tap-hold-press 120 180 f15 (layer-while-held wm))

  ;; Space+Q sends Escape and then turns IME off.
  escimeoff (macro esc f13)

  ;; Shift changes workspace focus into move-and-follow.
  wm1 (switch ((or (input real lsft) (input real rsft))) C-A-S-1 break () C-A-1 break)
  wm2 (switch ((or (input real lsft) (input real rsft))) C-A-S-2 break () C-A-2 break)
  wm3 (switch ((or (input real lsft) (input real rsft))) C-A-S-3 break () C-A-3 break)
  wm4 (switch ((or (input real lsft) (input real rsft))) C-A-S-4 break () C-A-4 break)
  wm5 (switch ((or (input real lsft) (input real rsft))) C-A-S-5 break () C-A-5 break)
  wm6 (switch ((or (input real lsft) (input real rsft))) C-A-S-6 break () C-A-6 break)
  wm7 (switch ((or (input real lsft) (input real rsft))) C-A-S-7 break () C-A-7 break)
  wm8 (switch ((or (input real lsft) (input real rsft))) C-A-S-8 break () C-A-8 break)
  wm9 (switch ((or (input real lsft) (input real rsft))) C-A-S-9 break () C-A-9 break)
  wm0 (switch ((or (input real lsft) (input real rsft))) C-A-S-0 break () C-A-0 break)
  wmminus (switch ((or (input real lsft) (input real rsft))) C-A-S-- break () C-A-- break)
  wmequal (switch ((or (input real lsft) (input real rsft))) C-A-S-= break () C-A-= break)

  ;; Private function keys prevent GlazeWM navigation from leaking text input.
  wmh (switch ((or (input real lctl) (input real rctl))) f20 break () f16 break)
  wmj (switch ((or (input real lctl) (input real rctl))) f21 break () f17 break)
  wmk (switch ((or (input real lctl) (input real rctl))) f22 break () f18 break)
  wml (switch ((or (input real lctl) (input real rctl))) f23 break () f19 break)
  wmf (switch ((or (input real lsft) (input real rsft))) C-A-S-f break () C-A-f break)
  wmcomma (switch ((or (input real lctl) (input real rctl))) C-A-S-, break () C-A-, break)
  wmperiod (switch ((or (input real lctl) (input real rctl))) C-A-S-. break () C-A-. break)

  to-us  (layer-switch us)
  to-jis (layer-switch jis)
)

(defsrc
  grv  1    2    3    4    5    6    7    8    9    0    -    =    bspc
  tab  q    w    e    r    t    y    u    i    o    p    [    ]    \
  caps a    s    d    f    g    h    j    k    l    ;    '    ret
  lsft z    x    c    v    b    n    m    ,    .    /    ro   rsft
  lctl lmet lalt           spc            ralt rmet rctl
  left down up rght
  f13  f15
)

;; Default layer. Native Win and Alt keys are never remapped.
(deflayer us
  _    _    _    _    _    _    _    _    _    _    _    _    _    _
  _    _    _    _    _    _    _    _    _    _    _    _    _    _
  _    _    _    _    _    _    _    _    _    _    _    _    _
  _    _    _    _    _    _    _    _    _    _    _    _    _
  _    _    _              @spcnav        _    _    _
  _    _    _    _
  @imeoffmod @imeonmod
)

;; JIS physical keyboard compensation layer.
(deflayer jis
  _    _    _    _    _    _    _    _    _    _    _    _    _    _
  _    _    _    _    _    _    _    _    _    _    _    _    _    ret
  _    _    _    _    _    _    _    _    _    _    _    _    bspc
  _    _    _    _    _    _    _    _    _    _    _    rsft _
  _    _    _              @spcnav        _    _    _
  _    _    _    _
  @imeoffmod @imeonmod
)

(deflayer nav
  _    f1   f2   f3   f4   f5   f6   f7   f8   f9   f10  f11  f12  _
  _    @escimeoff _ _    _    _    home pgdn pgup end  _    grv  del  _
  _    _    _    _    _    _    left down up   rght -    =    _
  _    _    _    _    _    _    @to-us @to-jis _ _  \    _    _
  _    _    _              _              _    _    _
  _    _    _    _
  @imeoffmod @imeonmod
)

;; Hold either dedicated IME key for GlazeWM and retained Windows shortcuts.
(deflayer wm
  XX   @wm1 @wm2 @wm3 @wm4 @wm5 @wm6 @wm7 @wm8 @wm9 @wm0 @wmminus @wmequal XX
  A-tab C-A-q XX XX XX XX XX XX XX XX pp XX XX XX
  XX   XX   M-S-s XX @wmf XX @wmh @wmj @wmk @wml XX XX C-A-t
  XX   XX   XX   XX   XX   C-A-b XX C-A-f12 @wmcomma @wmperiod f24 XX XX
  _    _    _              A-spc          _    _    _
  C-A-left C-A-down C-A-up C-A-rght
  XX   XX
)
