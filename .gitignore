# Deny new top-level content by default. Public repository entries must be
# explicitly allowed here and pass scripts/security/check-public-tree.sh.
/*

!/.github/
!/.github/**
!/.gitignore
!/AGENTS.md
!/CLAUDE.md
!/LICENSE
!/README.md
!/examples/
!/examples/**
!/install.sh
!/mise.toml
!/packages/
!/packages/**
!/scripts/
!/scripts/**
!/stow/
!/stow/**
!/vivaldi-css/
!/vivaldi-css/**
!/windows/
!/windows/**

# Credentials and mutable application state must never be committed.
**/.env
**/.env.*
**/.zsh_secrets
**/.zshrc.local
**/.netrc
**/.npmrc
**/.pypirc
**/.aws/**
**/.azure/**
**/.kube/**
**/.docker/config.json
**/.gem/credentials
**/.config/gcloud/**
**/.config/gh/hosts.yml
**/.config/atcoder-cli-nodejs/session.json
**/.config/TabNine/**
**/.config/mozc/**
**/.codex/auth.json
**/.codex/config.toml
**/.claude/settings.json
**/.claude/settings.local.json
**/.claude/session-summary.md
**/.claude-work/**
**/*.local.json
**/*.pem
**/*.key
**/*.p12
**/*.pfx
**/*.kdbx

# Generated files.
**/__pycache__/
**/*.pyc
**/node_modules/
**/coverage/
**/*.log
**/.DS_Store
